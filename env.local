# ===================================
# STILL FM - Environment Variables
# ===================================

# RADIO STREAM (Icecast/SHOUTcast)
# ---------------------------------
# Pour DEV local (si tu testes Icecast):
# NEXT_PUBLIC_RADIO_URL=http://localhost:8000/steelfm.mp3

# Pour PRODUCTION (désactivé jusqu'au meeting client):
# NEXT_PUBLIC_RADIO_URL=

# ℹ️ Si vide ou absent = Radio désactivée automatiquement
# ℹ️ Après meeting client, tu changes l'URL ici et sur Vercel

# TWITCH (rien à configurer, tout est dans le code)
# Channel: bertarose
# API: decapi.me/twitch (gratuit, pas besoin clé)

# MIXCLOUD (rien à configurer)
# Username: StillFM
# API publique

# ===================================
# INSTRUCTIONS VERCEL
# ===================================
# 1. Va sur vercel.com → ton projet → Settings
# 2. Environment Variables
# 3. Ajoute:
#    Name: NEXT_PUBLIC_RADIO_URL
#    Value: (vide pour désactiver OU ton URL radio)
# 4. Redeploy
